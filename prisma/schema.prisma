generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  code          String?
  city          String?
  academic_year String         @default("2026")
  director_name String?
  status        String         @default("active")
  created_at    DateTime       @default(now()) @db.Timestamptz(6)

  academicYears AcademicYear[]
  gradeLevels   GradeLevel[]
  classes       ClassRoom[]
  users         User[]
  teachers      Teacher[]
  missions      Mission[]

  @@map("schools")
}

model AcademicYear {
  id         String    @id @default(uuid()) @db.Uuid
  school_id  String?   @db.Uuid
  name       String
  start_date DateTime? @db.Date
  end_date   DateTime? @db.Date
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  school     School?   @relation(fields: [school_id], references: [id], onDelete: SetNull)

  @@index([school_id])
  @@map("academic_years")
}

model GradeLevel {
  id          String      @id @default(uuid()) @db.Uuid
  school_id   String?     @db.Uuid
  name        String
  stage       String      @default("Ensino Fundamental II")
  order_index Int         @default(1)
  description String?
  status      String      @default("active")
  created_at  DateTime    @default(now()) @db.Timestamptz(6)

  school      School?     @relation(fields: [school_id], references: [id], onDelete: SetNull)
  classes     ClassRoom[]

  @@index([school_id])
  @@map("grade_levels")
}

model ClassRoom {
  id             String      @id @default(uuid()) @db.Uuid
  school_id      String?     @db.Uuid
  grade_level_id String?     @db.Uuid
  name           String
  shift          String      @default("Matutino")
  academic_year  String      @default("2026")
  room           String?
  capacity       Int         @default(35)
  status         String      @default("active")
  created_at     DateTime    @default(now()) @db.Timestamptz(6)

  school         School?     @relation(fields: [school_id], references: [id], onDelete: SetNull)
  gradeLevel     GradeLevel? @relation(fields: [grade_level_id], references: [id], onDelete: SetNull)
  students       Student[]

  @@index([school_id])
  @@index([grade_level_id])
  @@map("classes")
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  school_id     String?   @db.Uuid
  email         String    @unique
  name          String
  role          String    @default("student")
  status        String    @default("active")
  password_hash String?
  last_login_at DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @updatedAt @db.Timestamptz(6)

  school        School?   @relation(fields: [school_id], references: [id], onDelete: SetNull)
  teachers      Teacher[]
  students      Student[]

  @@index([school_id])
  @@index([role])
  @@map("users")
}

model Teacher {
  id             String   @id @default(uuid()) @db.Uuid
  user_id        String?  @db.Uuid
  school_id      String?  @db.Uuid
  name           String
  email          String?
  subject        String   @default("Docente")
  classes_linked String   @default("Sem turma vinculada")
  phone          String?
  status         String   @default("active")
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  user           User?    @relation(fields: [user_id], references: [id], onDelete: SetNull)
  school         School?  @relation(fields: [school_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([school_id])
  @@map("teachers")
}

model Student {
  id                String     @id @default(uuid()) @db.Uuid
  user_id           String?    @db.Uuid
  class_id          String?    @db.Uuid
  name              String
  email             String?
  enrollment_number String     @unique
  guardian_name     String?
  guardian_contact  String?
  birth_date        String?
  photo_path        String?
  lgpd_consent      Boolean    @default(true)
  status            String     @default("active")
  created_at        DateTime   @default(now()) @db.Timestamptz(6)

  user              User?      @relation(fields: [user_id], references: [id], onDelete: SetNull)
  classRoom         ClassRoom? @relation(fields: [class_id], references: [id], onDelete: SetNull)
  wallet            Wallet?

  @@index([user_id])
  @@index([class_id])
  @@map("students")
}

model Wallet {
  id           String              @id @default(uuid()) @db.Uuid
  student_id   String              @unique @db.Uuid
  balance      Decimal             @default(0) @db.Decimal(12, 2)
  total_earned Decimal             @default(0) @db.Decimal(12, 2)
  total_spent  Decimal             @default(0) @db.Decimal(12, 2)
  created_at   DateTime            @default(now()) @db.Timestamptz(6)
  updated_at   DateTime            @updatedAt @db.Timestamptz(6)

  student      Student             @relation(fields: [student_id], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String   @id @default(uuid()) @db.Uuid
  wallet_id   String   @db.Uuid
  type        String
  amount      Decimal  @db.Decimal(12, 2)
  description String
  created_by  String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  wallet      Wallet   @relation(fields: [wallet_id], references: [id], onDelete: Cascade)

  @@index([wallet_id])
  @@map("wallet_transactions")
}

model Mission {
  id            String   @id @default(uuid()) @db.Uuid
  school_id     String?  @db.Uuid
  title         String
  description   String?
  subject       String   @default("Geral")
  reward_amount Int      @default(0)
  status        String   @default("active")
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  school        School?  @relation(fields: [school_id], references: [id], onDelete: SetNull)

  @@index([school_id])
  @@map("missions")
}

model Reward {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  price       Decimal  @default(0) @db.Decimal(12, 2)
  stock       Int      @default(0)
  category_id String?  @db.Uuid
  image_path  String?
  status      String   @default("active")
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("rewards")
}

